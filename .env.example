# ==============================================================================
# AniBoop Environment Configuration
# Copy this file to .env.local for local overrides: `cp .env.example .env.local`
# ==============================================================================

# [Production Only] Public canonical site origin.
# Required in production deployments to enable search engine indexing (robots.txt, sitemap.xml, canonical URLs, JSON-LD).
# In local development (`npm run dev`) or preview deployments, leave this unset to ensure noindex.
# Example: https://aniboop.nmrisrl.dev
ANIBOOP_URL=

# [Production & Preview] Cloudflare R2 public origin for all mascot WebP tiers (previews/, gallery-sheets/, sheets/).
# Point this to your custom domain or public Cloudflare R2 bucket URL ($0 egress fees).
# When unset (e.g. offline local dev), the app falls back to local /mascots/* files.
# Example: https://aniboop-assets.nmrisrl.dev or https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
NEXT_PUBLIC_R2_ASSETS_URL=

# [Local CLI Only] Cloudflare R2 credentials for automated syncing (`npm run mascot:sync-r2`, `mascot:add`, `mascot:update`).
# Keep these in local .env.local only — never set upload credentials on Vercel.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=aniboop-assets
